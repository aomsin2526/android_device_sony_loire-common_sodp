typeattribute vendor_init data_between_core_and_vendor_violators;

get_prop(vendor_init, atfwd_start_prop)
get_prop(vendor_init, vendor_usb_prop)
set_prop(vendor_init, vendor_radio_prop)

#============= vendor_init ==============
allow vendor_init proc:file write;
allow vendor_init proc_watermark_scale_factor:file write;
allow vendor_init tad_block_device:blk_file setattr;
allow vendor_init tmpfs:dir { add_name write };
allow vendor_init tmpfs:lnk_file create;
allow vendor_init {
  camera_data_file
  cnd_data_file
  credmgrd_data_file
  dhcp_data_file
  media_rw_data_file
  nfc_data_file
  system_data_file
  ta_data_file
  tombstone_data_file
  wifi_data_file
}:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };
