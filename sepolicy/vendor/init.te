#============= init ==============
allow init {
    adsprpcd_file
    firmware_file
    idd_rca_file
    idd_root_dir
    mnt_vendor_file
    persist_file
}:dir mounton;
allow firmware_file self:filesystem associate;
allow init firmware_file:filesystem { associate getattr mount relabelfrom };
allow init sysfs_mmc:file w_file_perms;
allow init system_file:file mounton;
