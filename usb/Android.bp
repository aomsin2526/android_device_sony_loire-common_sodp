cc_binary {
    name: "android.hardware.usb@1.0-service.loire",
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb@1.0-service.loire.rc"],
    vintf_fragments: ["android.hardware.usb@1.0-service.loire.xml"],
    srcs: ["service.cpp", "Usb.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "libutils",
        "libhardware",
        "android.hardware.usb@1.0",
    ],
    proprietary: true,
}
