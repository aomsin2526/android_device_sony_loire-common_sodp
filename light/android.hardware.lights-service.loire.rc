on early-boot
    # Notification LEDs
    chown system system /sys/class/leds/as3668:red/brightness
    chown system system /sys/class/leds/as3668:red/max_brightness
    chown system system /sys/class/leds/as3668:red/pattern_brightness

    chown system system /sys/class/leds/as3668:green/brightness
    chown system system /sys/class/leds/as3668:green/max_brightness
    chown system system /sys/class/leds/as3668:green/pattern_brightness

    chown system system /sys/class/leds/as3668:blue/brightness
    chown system system /sys/class/leds/as3668:blue/max_brightness
    chown system system /sys/class/leds/as3668:blue/pattern_brightness

    chown system system /sys/class/leds/as3668/pattern_pwm_dim_speed_down_ms
    chown system system /sys/class/leds/as3668/pattern_pwm_dim_speed_up_ms
    chown system system /sys/class/leds/as3668/pattern_run

    # Backlight
    chown system system /sys/class/backlight/backlight/brightness
    chown system system /sys/class/backlight/backlight/max_brightness

    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/max_brightness

service vendor.light /vendor/bin/hw/android.hardware.lights-service.loire
    class hal
    user system
    group system
    shutdown critical
