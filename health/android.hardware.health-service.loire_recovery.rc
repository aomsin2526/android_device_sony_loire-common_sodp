on early-boot
    # AS3668 RGB LED
    chown system system /sys/class/leds/as3668:red/brightness
    chown system system /sys/class/leds/as3668:red/pattern_brightness

    chown system system /sys/class/leds/as3668:green/brightness
    chown system system /sys/class/leds/as3668:green/pattern_brightness

    chown system system /sys/class/leds/as3668:blue/brightness
    chown system system /sys/class/leds/as3668:blue/pattern_brightness

    chown system system /sys/class/leds/as3668/pattern_pwm_dim_speed_down_ms
    chown system system /sys/class/leds/as3668/pattern_pwm_dim_speed_up_ms
    chown system system /sys/class/leds/as3668/pattern_run

service vendor.health-loire /system/bin/hw/android.hardware.health-service.loire_recovery
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:hal_health_default:s0
